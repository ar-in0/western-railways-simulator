+    @staticmethod
+    def normalizeStationName(name):
+        """Normalize station names to match internal representation"""
+        if not name or pd.isna(name):
+            return None
+        name = str(name).strip().upper()
+        
+        # Apply all normalization rules in one place
+        normalizations = {
+            "M'BAI CENTRAL (L)": "M'BAI CENTRAL(L)",
+            "KANDIVLI": "KANDIVALI"
+        }
+        return normalizations.get(name, name)
+    
+    @staticmethod
+    def getStationNameFromSheet(sheet, rowIdx, lookback=2):
+        """Get station name from row, looking back up to lookback rows if needed"""
+        for offset in range(lookback + 1):
+            if rowIdx - offset < 0:
+                break
+            stName = sheet.iat[rowIdx - offset, 0]
+            if not pd.isna(stName) and str(stName).strip():
+                return stName
+        return None
     
