from enum import Enum


def fmt_time(t):
    """Format time in minutes to HH:MM string"""
    if t is None:
        return "--:--"
    t = int(round(t))
    return f"{t//60:02d}:{t%60:02d}"


class FilterType(Enum):
    RAKELINK = "rakelink"
    SERVICE = "service"
    STATION = "station"


@dataclass
class FilterQuery:
    type: Optional[FilterType] = None

    # Make fields mode-specific (no properties needed)
    startStation: Optional[str] = None
    endStation: Optional[str] = None
    passingThrough: List[str] = field(default_factory=list)
    inTimePeriod: Optional[Tuple[int, int]] = (165, 1605)

    ac: Optional[bool] = None
    inDirection: Optional[List[str]] = None
    selectedLinks: List[str] = field(default_factory=list)
    selectedServices: List[str] = field(default_factory=list)


class HTMLBuilder:
    """Helper class for building HTML components"""

    @staticmethod
    def build_service_row(svc, i, n):
        """Build a service row for rake path display"""
        svc_id_str = (
            ",".join(str(sid) for sid in svc.serviceId) if svc.serviceId else "?"
        )

        row = html.Div(
            [
                html.Span(
                    svc_id_str, style={"minWidth": "56px", "display": "inline-block"}
                ),
                html.Span(
                    f"{svc.initStation.name} → {svc.finalStation.name} ({svc.direction})",
                    style={"marginLeft": "6px"},
                ),
                html.Span(
                    fmt_time(
                        next(
                            (e.atTime for e in svc.events if e.atTime is not None), None
                        )
                    ),
                    style={"marginLeft": "6px", "color": "#64748b"},
                ),
            ],
            style={"fontSize": "12px"},
        )

        if i < n - 1:
            return html.Div([row, html.Div("│", style={"marginLeft": "6px"})])
        return row

    @staticmethod
    def build_service_detail_block(svc):
        """Build service detail block for service query info"""
        svc_id_str = ",".join(str(sid) for sid in svc.serviceId)

        return html.Div(
            [
                html.Div(
                    f"Service {svc_id_str}",
                    style={"fontWeight": "600", "marginBottom": "4px"},
                ),
                html.Div(
                    f"{svc.direction.name} | {svc.initStation.name} → {svc.finalStation.name}",
                    style={"fontSize": "12px", "color": "#64748b"},
                ),
                html.Div(
                    f"{'AC' if svc.needsACRake else 'Non-AC'} | {svc.rakeSizeReq}-car | {len(svc.events)} stops",
                    style={
                        "fontSize": "12px",
                        "color": "#64748b",
                        "marginBottom": "8px",
                    },
                ),
                html.Hr(style={"margin": "8px 0"}),
            ]
        )

    @staticmethod
    def build_rake_path_block(rc, services):
        """Build rake path detail block"""
        n = len(services)
        start = services[0].initStation.name
        end = services[-1].finalStation.name
        ac = sum(1 for s in services if s.needsACRake)

        return html.Details(
            [
                html.Summary(
                    [
                        html.Span(f"Rake {rc.linkName}", style={"fontWeight": "600"}),
                        html.Span(
                            f"  · {len(services)} services ·  ",
                            style={"color": "#64748b"},
                        ),
                        html.Span(f"{start} → {end}"),
                        html.Span(
                            f"  {'AC' if ac == len(services) else 'Non-AC' if ac == 0 else 'Mixed AC'}",
                            style={"marginLeft": "6px", "color": "#475569"},
                        ),
                    ],
                    style={
                        "cursor": "pointer",
                        "fontSize": "13px",
                        "lineHeight": "1.4",
                    },
                ),
                html.Div(
                    [
                        HTMLBuilder.build_service_row(svc, i, n)
                        for i, svc in enumerate(services)
                    ],
                    style={"marginLeft": "14px", "marginTop": "6px"},
                ),
            ]
        )

    @staticmethod
    def build_minimal_rake_block(rc):
        """Build minimal rake block for display"""
        rows = []
        for i, svc in enumerate(rc.servicePath, start=1):
            rows.append(
                {
                    "seq": i,
                    "service_id": ", ".join(str(s) for s in svc.serviceId),
                    "start": svc.initStation.name,
                    "end": svc.finalStation.name,
                    "ac": "AC" if svc.needsACRake else "Non-AC",
                }
            )

        return html.Div(
            [
                html.Div(
                    f"Rake {rc.linkName} | "
                    f"{'AC' if rc.rake.isAC else 'Non-AC'} | "
                    f"{rc.rake.size}-car | "
                    f"{len(rc.servicePath)} services",
                    style={"fontWeight": "600", "marginBottom": "8px"},
                ),
                dash_table.DataTable(
                    columns=[
                        {"name": "#", "id": "seq"},
                        {"name": "Service", "id": "service_id"},
                        {"name": "Start", "id": "start"},
                        {"name": "End", "id": "end"},
                        {"name": "AC?", "id": "ac"},
                    ],
                    data=rows,
                    style_table={"overflowX": "auto"},
                    style_cell={
                        "padding": "6px",
                        "fontSize": "12px",
                        "textAlign": "left",
                    },
                    style_header={
                        "fontWeight": "600",
                        "backgroundColor": "#f1f5f9",
                    },
                ),
                html.Hr(style={"margin": "12px 0"}),
            ]
        )


class Simulator:
    def __init__(self):
        self.app = Dash(external_stylesheets=[dbc.themes.BOOTSTRAP])
        self.parser = None
        self.wttContents = None
        self.summaryContents = None
        self.wttFileName = None
        self.summaryFileName = None

        self._ui = SimulatorUI()
        # set initial layout
        self.app.layout = self._ui.drawLayout()
        self.initCallbacks()
        self.linkTimingsCreated = False

        self.query = FilterQuery()
        self.query.type = FilterType.RAKELINK

        self.filterStates = {
            FilterType.RAKELINK: {},
            FilterType.SERVICE: {},
            FilterType.STATION: {},
        }

    def build_query_info_panel(self):
        if self.query.type == FilterType.RAKELINK:
            return self.build_rake_link_query_info()
        elif self.query.type == FilterType.SERVICE:
            return self.build_service_query_info()
        else:
            return html.Div("No query context available.")

    def build_service_query_info(self):
        if not self.query.selectedServices:
            return html.Div("No services selected.")

        # Find selected service objects
        selected_svcs = [
            svc
            for svc in self.parser.wtt.suburbanServices
            if any(str(sid) in self.query.selectedServices for sid in svc.serviceId)
        ]

        return html.Div(
            [
                html.Div(
                    "Selected Services",
                    style={
                        "fontSize": "13px",
                        "fontWeight": "600",
                        "color": "#475569",
                        "marginBottom": "6px",
                    },
                ),
                *[HTMLBuilder.build_service_detail_block(svc) for svc in selected_svcs],
            ],
            style={"padding": "8px"},
        )

    def build_rake_link_query_info(self):
        if not self.query.selectedLinks:
            return html.Div("No rake links selected.")

        selected_rcs = [
            rc
            for rc in self.parser.wtt.rakecycles
            if rc.linkName in self.query.selectedLinks
        ]

        return html.Div(
            [
                html.Div(
                    "Selected Rake Links",
                    style={
                        "fontSize": "13px",
                        "fontWeight": "600",
                        "color": "#475569",
                        "marginBottom": "6px",
                    },
                ),
                *[
                    HTMLBuilder.build_rake_path_block(rc, rc.servicePath)
                    for rc in selected_rcs
                ],
            ],
            style={"padding": "8px"},
        )

    def parse_uploaded_file(self, contents, filename):
        """Parse uploaded file content"""
        content_type, content_string = contents.split(",")
        decoded = base64.b64decode(content_string)
        return io.BytesIO(decoded), filename

    def process_file_uploads(
        self, wtt_contents, wtt_filename, summary_contents, summary_filename
    ):
        """Process uploaded files and initialize parser"""
        if wtt_contents:
            wtt_file, _ = self.parse_uploaded_file(wtt_contents, wtt_filename)
            self.wttContents = wtt_contents
            self.wttFileName = wtt_filename
        else:
            wtt_file = None

        if summary_contents:
            summary_file, _ = self.parse_uploaded_file(
                summary_contents, summary_filename
            )
            self.summaryContents = summary_contents
            self.summaryFileName = summary_filename
        else:
            summary_file = None

        if wtt_file and summary_file:
            self.parser = tt.TTParser(wttFile=wtt_file, linkFile=summary_file)
            self.parser.parse()
            self.parser.buildRakeCycles()
            self.linkTimingsCreated = False
            return True
        return False

    def get_station_options(self):
        """Get station dropdown options"""
        if not self.parser:
            return []
        stations = sorted(self.parser.wtt.stations, key=lambda x: x.name)
        return [
            {"label": f"{st.name} ({st.code})", "value": st.code} for st in stations
        ]

    def apply_filters_to_data(self):
        """Apply current filters to timetable data"""
        if not self.parser:
            return

        for rc in self.parser.wtt.rakecycles:
            rc.render = True
            for svc in rc.servicePath:
                svc.render = True
                for ev in svc.events:
                    ev.render = True

        if self.query.type == FilterType.RAKELINK:
            self.apply_rakelink_filters()
        elif self.query.type == FilterType.SERVICE:
            self.apply_service_filters()
        elif self.query.type == FilterType.STATION:
            self.apply_station_filters()

    def apply_rakelink_filters(self):
        """Apply rake link specific filters"""
        for rc in self.parser.wtt.rakecycles:
            if self.query.selectedLinks and rc.linkName not in self.query.selectedLinks:
                rc.render = False
                continue

            if self.query.ac is not None:
                if self.query.ac and not rc.rake.isAC:
                    rc.render = False
                    continue
                if not self.query.ac and rc.rake.isAC:
                    rc.render = False
                    continue

            if self.query.inDirection:
                has_dir = any(
                    svc.direction.name in self.query.inDirection
                    for svc in rc.servicePath
                )
                if not has_dir:
                    rc.render = False
                    continue

    def apply_service_filters(self):
        """Apply service specific filters"""
        for rc in self.parser.wtt.rakecycles:
            rc.render = False

            for svc in rc.servicePath:
                svc_ids = [str(sid) for sid in svc.serviceId]

                if self.query.selectedServices:
                    if any(sid in self.query.selectedServices for sid in svc_ids):
                        rc.render = True
                        svc.render = True
                        self.apply_time_filter_to_service(svc)
                    else:
                        svc.render = False
                else:
                    svc.render = False

    def apply_station_filters(self):
        """Apply station specific filters"""
        for rc in self.parser.wtt.rakecycles:
            rc.render = False

            for svc in rc.servicePath:
                svc.render = False

                passes = self.check_service_passes_stations(svc)

                if passes:
                    rc.render = True
                    svc.render = True
                    self.apply_time_filter_to_service(svc)

    def check_service_passes_stations(self, svc):
        """Check if service passes through required stations"""
        station_codes = [ev.atStation.code for ev in svc.events if ev.atStation]

        start_match = (
            not self.query.startStation or self.query.startStation in station_codes
        )
        end_match = not self.query.endStation or self.query.endStation in station_codes

        if self.query.passingThrough:
            passes_through = all(
                st in station_codes for st in self.query.passingThrough
            )
        else:
            passes_through = True

        return start_match and end_match and passes_through

    def apply_time_filter_to_service(self, svc):
        """Apply time period filter to service events"""
        if not self.query.inTimePeriod:
            return

        t_start, t_end = self.query.inTimePeriod

        for ev in svc.events:
            if ev.atTime is not None:
                if t_start <= ev.atTime <= t_end:
                    ev.render = True
                else:
                    ev.render = False

    def generate_rake_link_table_data(self):
        """Generate data for rake link table"""
        if not self.parser:
            return []

        table_data = []
        for rc in self.parser.wtt.rakecycles:
            if not rc.render:
                continue

            start_svc = rc.servicePath[0]
            end_svc = rc.servicePath[-1]

            table_data.append(
                {
                    "linkname": rc.linkName,
                    "cars": rc.rake.size,
                    "is_ac": "AC" if rc.rake.isAC else "Non-AC",
                    "length_km": f"{rc.rake.length:.1f}",
                    "start": start_svc.initStation.name,
                    "end": end_svc.finalStation.name,
                    "n_services": len(rc.servicePath),
                }
            )

        return table_data

    def generate_service_table_data(self):
        """Generate data for service table"""
        if not self.parser:
            return []

        table_data = []
        for rc in self.parser.wtt.rakecycles:
            if not rc.render:
                continue

            for svc in rc.servicePath:
                if not svc.render:
                    continue

                svc_id_str = ",".join(str(sid) for sid in svc.serviceId)
                start_time = next(
                    (e.atTime for e in svc.events if e.atTime is not None), None
                )

                table_data.append(
                    {
                        "service_id": svc_id_str,
                        "direction": svc.direction.name,
                        "is_ac": "AC" if svc.needsACRake else "Non-AC",
                        "cars": svc.rakeSizeReq,
                        "start_station": svc.initStation.name,
                        "end_station": svc.finalStation.name,
                        "start_time": fmt_time(start_time),
                        "rake_link": rc.linkName,
                    }
                )

        return table_data

    def save_filter_state(self):
        """Save current filter state"""
        current_state = {
            "selectedLinks": self.query.selectedLinks.copy(),
            "selectedServices": self.query.selectedServices.copy(),
            "startStation": self.query.startStation,
            "endStation": self.query.endStation,
            "passingThrough": (
                self.query.passingThrough.copy() if self.query.passingThrough else []
            ),
            "inTimePeriod": self.query.inTimePeriod,
            "ac": self.query.ac,
            "inDirection": (
                self.query.inDirection.copy() if self.query.inDirection else None
            ),
        }
        self.filterStates[self.query.type] = current_state

    def restore_filter_state(self, filter_type):
        """Restore saved filter state"""
        if filter_type not in self.filterStates or not self.filterStates[filter_type]:
            return

        state = self.filterStates[filter_type]
        self.query.selectedLinks = state.get("selectedLinks", []).copy()
        self.query.selectedServices = state.get("selectedServices", []).copy()
        self.query.startStation = state.get("startStation")
        self.query.endStation = state.get("endStation")
        self.query.passingThrough = state.get("passingThrough", []).copy()
        self.query.inTimePeriod = state.get("inTimePeriod")
        self.query.ac = state.get("ac")
        self.query.inDirection = (
            state.get("inDirection", []).copy() if state.get("inDirection") else None
        )

    def initCallbacks(self):
        @self.app.callback(
            [
                Output("upload-wtt-inline", "style"),
                Output("upload-summary-inline", "style"),
                Output("status-div", "children"),
                Output("graph-ready", "data"),
                Output("generate-button", "disabled"),
                Output("start-station-dropdown", "options"),
                Output("end-station-dropdown", "options"),
                Output("passing-through-dropdown", "options"),
            ],
            [
                Input("upload-wtt-inline", "contents"),
                Input("upload-summary-inline", "contents"),
            ],
            [
                State("upload-wtt-inline", "filename"),
                State("upload-summary-inline", "filename"),
            ],
        )
        def handle_upload(
            wtt_contents, summary_contents, wtt_filename, summary_filename
        ):
            ctx = callback_context
            if not ctx.triggered:
                raise PreventUpdate

            wtt_style = {
                "height": "140px",
                "borderWidth": "2px",
                "borderStyle": "dashed",
                "borderRadius": "12px",
                "borderColor": "#cbd5e1",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "cursor": "pointer",
                "transition": "all 0.2s ease",
            }
            summary_style = wtt_style.copy()

            if wtt_contents:
                wtt_style["borderColor"] = "#22c55e"
                wtt_style["backgroundColor"] = "#f0fdf4"

            if summary_contents:
                summary_style["borderColor"] = "#22c55e"
                summary_style["backgroundColor"] = "#f0fdf4"

            files_ready = self.process_file_uploads(
                wtt_contents, wtt_filename, summary_contents, summary_filename
            )

            if files_ready:
                status = html.Div(
                    [
                        html.I(
                            className="fas fa-check-circle",
                            style={"color": "#22c55e", "marginRight": "8px"},
                        ),
                        html.Span(
                            "Files loaded successfully", style={"fontWeight": "500"}
                        ),
                    ],
                    style={
                        "color": "#15803d",
                        "padding": "8px 12px",
                        "backgroundColor": "#f0fdf4",
                        "borderRadius": "6px",
                    },
                )
                station_opts = self.get_station_options()
                return (
                    wtt_style,
                    summary_style,
                    status,
                    True,
                    False,
                    station_opts,
                    station_opts,
                    station_opts,
                )
            elif wtt_contents and summary_contents:
                status = html.Div(
                    [
                        html.I(
                            className="fas fa-exclamation-circle",
                            style={"color": "#dc2626", "marginRight": "8px"},
                        ),
                        html.Span("Error loading files", style={"fontWeight": "500"}),
                    ],
                    style={
                        "color": "#991b1b",
                        "padding": "8px 12px",
                        "backgroundColor": "#fef2f2",
                        "borderRadius": "6px",
                    },
                )
                return wtt_style, summary_style, status, False, True, [], [], []
            else:
                status = html.Div(
                    [
                        html.I(
                            className="fas fa-info-circle",
                            style={"color": "#64748b", "marginRight": "8px"},
                        ),
                        html.Span(
                            "Please upload both files to begin",
                            style={"fontWeight": "400"},
                        ),
                    ],
                    style={
                        "color": "#475569",
                        "padding": "8px 12px",
                        "backgroundColor": "#f8fafc",
                        "borderRadius": "6px",
                    },
                )
                return wtt_style, summary_style, status, False, True, [], [], []

        @self.app.callback(
            [
                Output("filter-tab-rakelink", "style"),
                Output("filter-tab-service", "style"),
                Output("filter-tab-station", "style"),
                Output("filter-overlay", "style"),
                Output("rakelink-filters", "style"),
                Output("service-filters", "style"),
                Output("station-filters", "style"),
            ],
            [
                Input("filter-tab-rakelink", "n_clicks"),
                Input("filter-tab-service", "n_clicks"),
                Input("filter-tab-station", "n_clicks"),
            ],
            [State("graph-ready", "data")],
        )
        def switch_filter_tabs(n_rl, n_svc, n_st, graph_ready):
            ctx = callback_context
            if not ctx.triggered:
                raise PreventUpdate

            trigger = ctx.triggered[0]["prop_id"].split(".")[0]

            inactive_tab_style = {
                "backgroundColor": "#f1f5f9",
                "color": "#64748b",
                "padding": "6px 16px",
                "cursor": "pointer",
                "borderBottom": "2px solid transparent",
                "transition": "all 0.2s ease",
                "fontSize": "13px",
                "fontWeight": "500",
            }

            active_tab_style = inactive_tab_style.copy()
            active_tab_style.update(
                {
                    "backgroundColor": "white",
                    "color": "#0f172a",
                    "borderBottom": "2px solid #3b82f6",
                    "fontWeight": "600",
                }
            )

            hidden_style = {"display": "none"}
            visible_style = {"padding": "12px"}
            overlay_style = {"display": "none"}

            if not graph_ready:
                overlay_style = {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "right": "0",
                    "bottom": "0",
                    "backgroundColor": "rgba(255,255,255,0.8)",
                    "zIndex": "10",
                    "display": "flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                }

            if trigger == "filter-tab-service":
                self.save_filter_state()
                self.query.type = FilterType.SERVICE
                self.restore_filter_state(FilterType.SERVICE)
                return (
                    inactive_tab_style,
                    active_tab_style,
                    inactive_tab_style,
                    overlay_style,
                    hidden_style,
                    visible_style,
                    hidden_style,
                )
            elif trigger == "filter-tab-station":
                self.save_filter_state()
                self.query.type = FilterType.STATION
                self.restore_filter_state(FilterType.STATION)
                return (
                    inactive_tab_style,
                    inactive_tab_style,
                    active_tab_style,
                    overlay_style,
                    hidden_style,
                    hidden_style,
                    visible_style,
                )
            else:
                self.save_filter_state()
                self.query.type = FilterType.RAKELINK
                self.restore_filter_state(FilterType.RAKELINK)
                return (
                    active_tab_style,
                    inactive_tab_style,
                    inactive_tab_style,
                    overlay_style,
                    visible_style,
                    hidden_style,
                    hidden_style,
                )

        @self.app.callback(
            [
                Output("rake-link-table", "data"),
                Output("service-table", "data"),
                Output("rake-3d-graph", "figure"),
                Output("rake-link-count", "children"),
                Output("service-count", "children"),
            ],
            [Input("generate-button", "n_clicks")],
            [
                State("start-station-dropdown", "value"),
                State("end-station-dropdown", "value"),
                State("passing-through-dropdown", "value"),
                State("time-range-slider", "value"),
                State("ac-selector", "value"),
                State("direction-selector", "value"),
                State("graph-ready", "data"),
            ],
        )
        def generate_visualization(
            n_clicks,
            start_st,
            end_st,
            passing,
            time_range,
            ac_val,
            directions,
            graph_ready,
        ):
            if not graph_ready or n_clicks == 0:
                raise PreventUpdate

            self.query.startStation = start_st
            self.query.endStation = end_st
            self.query.passingThrough = passing if passing else []
            self.query.inTimePeriod = tuple(time_range) if time_range else None

            if ac_val == "ac":
                self.query.ac = True
            elif ac_val == "nonac":
                self.query.ac = False
            else:
                self.query.ac = None

            self.query.inDirection = directions if directions else None

            self.apply_filters_to_data()

            rl_data = self.generate_rake_link_table_data()
            svc_data = self.generate_service_table_data()
            fig = self.generate_3d_figure()

            rl_count = f"{len(rl_data)} rake link(s) found"
            svc_count = f"{len(svc_data)} service(s) found"

            return rl_data, svc_data, fig, rl_count, svc_count

        @self.app.callback(
            Output("rake-link-table-container", "style"),
            Output("service-table-container", "style"),
            [
                Input("filter-tab-rakelink", "n_clicks"),
                Input("filter-tab-service", "n_clicks"),
                Input("filter-tab-station", "n_clicks"),
            ],
        )
        def toggle_table_visibility(n_rl, n_svc, n_st):
            ctx = callback_context
            if not ctx.triggered:
                raise PreventUpdate

            trigger = ctx.triggered[0]["prop_id"].split(".")[0]

            if trigger == "filter-tab-service" or trigger == "filter-tab-station":
                return {"display": "none"}, {"padding": "10px 0px", "display": "block"}
            else:
                return {"padding": "10px 0px"}, {"display": "none"}

        @self.app.callback(
            [
                Output("rake-3d-graph", "style"),
                Output("right-panel-content", "children"),
            ],
            [
                Input("mode-viz", "n_clicks"),
                Input("mode-details", "n_clicks"),
            ],
            [State("graph-ready", "data")],
        )
        def toggle_view_mode(n_viz, n_details, graph_ready):
            ctx = callback_context
            if not ctx.triggered:
                raise PreventUpdate

            trigger = ctx.triggered[0]["prop_id"].split(".")[0]

            if trigger == "mode-details":
                return {"display": "none"}, self.build_query_info_panel()
            else:
                return {"height": "65vh", "display": "block"}, html.Div()

        @self.app.callback(
            [
                Output("mode-viz", "active"),
                Output("mode-details", "active"),
            ],
            [
                Input("mode-viz", "n_clicks"),
                Input("mode-details", "n_clicks"),
            ],
        )
        def update_mode_buttons(n_viz, n_details):
            ctx = callback_context
            if not ctx.triggered:
                return True, False

            trigger = ctx.triggered[0]["prop_id"].split(".")[0]

            if trigger == "mode-details":
                return False, True
            else:
                return True, False

        @self.app.callback(
            Output("rl-table-store", "data"),
            [Input("rake-link-table", "selected_rows")],
            [State("rake-link-table", "data")],
        )
        def store_selected_links(selected_rows, table_data):
            if not selected_rows or not table_data:
                self.query.selectedLinks = []
                return []

            selected_links = [table_data[i]["linkname"] for i in selected_rows]
            self.query.selectedLinks = selected_links
            return selected_links

        @self.app.callback(
            Output("app-state", "data"),
            [Input("service-table", "selected_rows")],
            [State("service-table", "data")],
        )
        def store_selected_services(selected_rows, table_data):
            if not selected_rows or not table_data:
                self.query.selectedServices = []
                return []

            selected_services = [table_data[i]["service_id"] for i in selected_rows]
            self.query.selectedServices = selected_services
            return selected_services

        @self.app.callback(
            Output("download-report", "data"),
            [Input("export-button", "n_clicks")],
            [State("graph-ready", "data")],
            prevent_initial_call=True,
        )
        def export_summary(n_clicks, graph_ready):
            if not graph_ready or not n_clicks:
                raise PreventUpdate

            summary_data = []
            for rc in self.parser.wtt.rakecycles:
                if not rc.render:
                    continue

                for i, svc in enumerate(rc.servicePath, start=1):
                    if not svc.render:
                        continue

                    svc_id_str = ",".join(str(sid) for sid in svc.serviceId)
                    start_time = next(
                        (e.atTime for e in svc.events if e.atTime is not None), None
                    )

                    summary_data.append(
                        {
                            "Rake Link": rc.linkName,
                            "Sequence": i,
                            "Service ID": svc_id_str,
                            "Direction": svc.direction.name,
                            "AC": "Yes" if svc.needsACRake else "No",
                            "Cars": svc.rakeSizeReq,
                            "Start Station": svc.initStation.name,
                            "End Station": svc.finalStation.name,
                            "Start Time": fmt_time(start_time),
                        }
                    )

            df = pd.DataFrame(summary_data)
            return dcc.send_data_frame(
                df.to_excel, "filtered_summary.xlsx", index=False, sheet_name="Summary"
            )

        @self.app.callback(
            Output("convert-ac-button", "disabled"),
            [
                Input("rl-table-store", "data"),
                Input("filter-tab-rakelink", "n_clicks"),
                Input("filter-tab-service", "n_clicks"),
                Input("filter-tab-station", "n_clicks"),
            ],
        )
        def update_convert_button(selected_links, n_rl, n_svc, n_st):
            ctx = callback_context
            if not ctx.triggered:
                raise PreventUpdate

            if self.query.type != FilterType.RAKELINK:
                return True

            if selected_links and len(selected_links) > 0:
                return False
            return True

        @self.app.callback(
            [
                Output("rake-link-table", "data", allow_duplicate=True),
                Output("rake-3d-graph", "figure", allow_duplicate=True),
            ],
            [Input("convert-ac-button", "n_clicks")],
            [State("rl-table-store", "data")],
            prevent_initial_call=True,
        )
        def convert_to_ac(n_clicks, selected_links):
            if not n_clicks or not selected_links:
                raise PreventUpdate

            for rc in self.parser.wtt.rakecycles:
                if rc.linkName in selected_links:
                    rc.rake.isAC = True
                    for svc in rc.servicePath:
                        svc.needsACRake = True

            self.apply_filters_to_data()
            rl_data = self.generate_rake_link_table_data()
            fig = self.generate_3d_figure()

            return rl_data, fig

    def generate_3d_figure(self):
        if not self.parser:
            return go.Figure()

        all_traces = []
        z_offset = 0
        z_labels = []

        stationToY = {}
        y_idx = 0
        for st in sorted(self.parser.wtt.stations, key=lambda x: x.name):
            stationToY[st.code] = y_idx
            y_idx += 5

        is_service_filter = self.query.type == FilterType.SERVICE

        for rc in self.parser.wtt.rakecycles:
            if is_service_filter:
                x_in, y_in, z_in, labels_in = [], [], [], []
                x_out, y_out, z_out, labels_out = [], [], [], []

                for svc in rc.servicePath:
                    if not svc.render:
                        continue

                    for ev in svc.events:
                        if not ev.atTime or not ev.atStation:
                            continue

                        minutes = ev.atTime
                        stName = str(ev.atStation).strip().upper()
                        if stName not in stationToY:
                            continue

                        # # Check if event is within the filtered time range
                        # ev_render = getattr(ev, 'render', True)

                        # if ev_render:
                        # Event is in the time filter range
                        x_in.append(minutes)
                        y_in.append(stationToY[stName])
                        z_in.append(z_offset)
                        labels_in.append(stName)
                        # else:
                        #     # Event is outside the time filter range
                        #     x_out.append(minutes)
                        #     y_out.append(stationToY[stName])
                        #     z_out.append(z_offset)
                        #     labels_out.append(stName)

                    # Format service IDs for display (handle list of IDs)
                    svc_id_str = (
                        ",".join(str(sid) for sid in svc.serviceId)
                        if svc.serviceId
                        else "?"
                    )

                    # Create trace for OUT-OF-RANGE events (dimmed, background context)
                    if x_out:
                        color_dim = (
                            "rgba(66,133,244,0.6)"
                            if svc.needsACRake
                            else "rgba(90,90,90,0.6)"
                        )

                        all_traces.append(
                            go.Scatter3d(
                                x=x_out,
                                y=y_out,
                                z=z_out,
                                mode="lines+markers",
                                line=dict(color=color_dim),
                                marker=dict(size=2, color=color_dim),
                                hovertext=[
                                    f"{svc_id_str}: {st} @ {(int(xx)//60) % 24:02d}:{int(xx%60):02d} (outside filter)"
                                    for xx, st in zip(x_out, labels_out)
                                ],
                                hoverinfo="text",
                                name=f"{rc.linkName}-{svc_id_str} (context)",
                                showlegend=False,  # Don't clutter legend with dimmed traces
                                visible=True,
                            )
                        )

                    # Create trace for IN-RANGE events (prominent, filtered results)
                    # color = "rgba(66,133,244,0.8)" if svc.needsACRake else "rgba(90,90,90,0.8)"
                    if x_in:
                        color_bright = (
                            "rgba(66,133,244,0.8)"
                            if svc.needsACRake
                            else "rgba(90,90,90,0.8)"
                        )

                        all_traces.append(
                            go.Scatter3d(
                                x=x_in,
                                y=y_in,
                                z=z_in,
                                mode="lines+markers",
                                line=dict(color=color_bright),
                                marker=dict(
                                    size=2, color=color_bright
                                ),  # Larger markers
                                hovertext=[
                                    f"{svc_id_str}: {st} @ {(int(xx)//60) % 24:02d}:{int(xx%60):02d}"
                                    for xx, st in zip(x_in, labels_in)
                                ],
                                hoverinfo="text",
                                name=f"{rc.linkName}-{svc_id_str}",
                                visible=True,
                            )
                        )
                        z_labels.append((z_offset, f"{rc.linkName}-{svc_id_str}"))

                    # Only increment z if we rendered something
                    if x_in or x_out:
                        z_offset += 40  # increment z for next service

            # RAKELINK mode
            else:
                # Check if this rake cycle passes the rake link filters
                if not rc.render:
                    continue

                if self.query.type == FilterType.STATION:
                    mode = "markers"
                elif self.query.type == FilterType.RAKELINK:
                    mode = "lines+markers"

                # Aggregate all services in the rake cycle into a single trace
                x, y, z, stationLabels = [], [], [], []

                for svc in rc.servicePath:
                    if not svc.render:
                        continue
                    # In rake link mode, we render all services in a visible rake cycle
                    for ev in svc.events:
                        if not ev.atTime or not ev.atStation:
                            continue

                        if not ev.render:
                            continue

                        minutes = ev.atTime
                        # print(minutes)

                        stName = str(ev.atStation).strip().upper()
                        if stName not in stationToY:
                            continue

                        x.append(minutes)
                        y.append(stationToY[stName])
                        z.append(z_offset)
                        stationLabels.append(stName)

                # Create single trace for entire rake cycle
                if x:
                    color = (
                        "rgba(66,133,244,0.8)" if rc.rake.isAC else "rgba(90,90,90,0.8)"
                    )

                    all_traces.append(
                        go.Scatter3d(
                            x=x,
                            y=y,
                            z=z,
                            mode=mode,
                            line=dict(color=color),
                            marker=dict(size=2, color=color),
                            # customdata=[{"link": rc.linkName} for _ in x],
                            hovertext=[
                                f"{rc.linkName}: {st} @ {(int(xx)//60) % 24:02d}:{int(xx%60):02d}"
                                for xx, st in zip(x, stationLabels)
                            ],
                            hoverinfo="text",
                            name=rc.linkName,
                            visible=True,
                        )
                    )
                    z_labels.append((z_offset, rc.linkName))
                    z_offset += 40  # increment z for next rakecycle

        if self.query.inTimePeriod and (
            self.query.type == FilterType.SERVICE
            or self.query.type == FilterType.STATION
        ):
            x_start, x_end = self.query.inTimePeriod
            x_end += 90  # padding
        else:
            x_start, x_end = 165, 1605
        # padding = 120  # 120 minutes
        # x_end = (x_end + padding)
        # x_start = max(0, x_start - padding)

        tickPositions = list(range(x_start, x_end + 1, 120))
        tickLabels = [f"{(t // 60) % 24:02d}:{int(t % 60):02d}" for t in tickPositions]

        yTickVals = list(stationToY.values())
        yTickText = list(stationToY.keys())

        fig = go.Figure(data=all_traces)

        fig.update_layout(
            font=dict(size=12, color="#CCCCCC"),
            scene=dict(
                xaxis=dict(
                    showgrid=True,
                    showspikes=False,
                    title="Time of Day →",
                    range=[x_start, x_end],
                    tickvals=tickPositions,
                    ticktext=tickLabels,
                ),
                yaxis=dict(
                    showgrid=True,
                    showspikes=False,
                    title="",
                    tickvals=yTickVals,
                    ticktext=yTickText,
                    range=[min(yTickVals), max(yTickVals)],
                    autorange=False,
                ),
                zaxis=dict(
                    showgrid=True,
                    showspikes=False,
                    title="Service" if is_service_filter else "Rake Cycle",
                    tickvals=[zv for zv, _ in z_labels],
                    ticktext=[zl for _, zl in z_labels],
                ),
                camera=dict(
                    eye=dict(x=0, y=0, z=2.5),
                    up=dict(x=0, y=1, z=0),
                    center=dict(x=0, y=0, z=0),
                ),
                aspectmode="manual",
                aspectratio=dict(x=2.8, y=1.2, z=1.2),
            ),
            scene_camera_projection_type="orthographic",
            width=1300,
            height=700,
            margin=dict(t=0, l=5, b=5, r=5),
            autosize=True,
        )

        return fig

    def run(self):
        self.app.run(debug=True, port=8051)


if __name__ == "__main__":
    sim = Simulator()
    sim.run()
